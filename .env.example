# Copy to .env and fill in with values from your Docusign developer account.
# https://developers.docusign.com/platform/apps-and-keys
# NEVER commit the real .env file.

# --- Docusign app credentials ---
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_CLIENT_SECRET=
DOCUSIGN_REDIRECT_URI=http://localhost:12000/oauth/callback

# --- JWT Grant (service integration, no user interaction) ---
# The API user ID (GUID) to impersonate. Copy from Apps and Keys > My Account Information.
DOCUSIGN_USER_ID=
# Path to the RSA private key downloaded when you added a key pair to your app.
DOCUSIGN_PRIVATE_KEY_PATH=./private_key.txt

# --- Environment ---
# "demo" -> account-d.docusign.com / api-d.docusign.com,
# "prod" -> account.docusign.com / api.docusign.com
DOCUSIGN_ENVIRONMENT=demo
# Leave blank to auto-discover from /oauth/userinfo
DOCUSIGN_ACCOUNT_ID=

# --- App ---
# Used to sign the local session cookie. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
APP_SESSION_SECRET=
APP_PORT=12000
